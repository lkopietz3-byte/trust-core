{
  "name": "trust-core",
  "version": "0.1.0",
  "description": "Composable entity-trust scoring: score known contributors, and detect astroturf in anonymous signals. Zero runtime dependencies.",
  "keywords": [
    "trust",
    "scoring",
    "reviews",
    "reputation",
    "astroturf",
    "authenticity"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identified": {
      "types": "./dist/identified/index.d.ts",
      "import": "./dist/identified/index.js"
    },
    "./anonymous": {
      "types": "./dist/anonymous/index.d.ts",
      "import": "./dist/anonymous/index.js"
    },
    "./shared": {
      "types": "./dist/shared/types.d.ts",
      "import": "./dist/shared/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}

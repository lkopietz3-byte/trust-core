{
  "name": "trust-core",
  "version": "0.2.0",
  "description": "Deterministic entity-trust scoring: weight known contributors' signals, and gauge how organic anonymous sentiment looks. Zero runtime dependencies.",
  "keywords": [
    "trust",
    "scoring",
    "reviews",
    "reputation",
    "astroturf",
    "authenticity"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/trust-core.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/trust-core#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/trust-core/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./identified": {
      "types": "./dist/identified/index.d.ts",
      "import": "./dist/identified/index.js",
      "default": "./dist/identified/index.js"
    },
    "./anonymous": {
      "types": "./dist/anonymous/index.d.ts",
      "import": "./dist/anonymous/index.js",
      "default": "./dist/anonymous/index.js"
    },
    "./shared": {
      "types": "./dist/shared/types.d.ts",
      "import": "./dist/shared/types.js",
      "default": "./dist/shared/types.js"
    }
  },
  "typesVersions": {
    "*": {
      "identified": [
        "./dist/identified/index.d.ts"
      ],
      "anonymous": [
        "./dist/anonymous/index.d.ts"
      ],
      "shared": [
        "./dist/shared/types.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "attw": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
